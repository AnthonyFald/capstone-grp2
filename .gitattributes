* text=auto
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
*.wav binary
*.pdf binary
*.docx binary

# Frozen inputs, source snapshots and pinned vendor files use byte-level hashes.
# Preserve their recorded line endings on every checkout.
demo-3/engine/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-3/consolidation-bench/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-3/fixtures/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-3/public/vendor/** -text -whitespace
demo-1/core.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-1/native-engine.cjs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-1/note-engine.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-1/note-engine-27.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
